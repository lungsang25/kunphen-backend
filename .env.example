DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/kunphen

# CORS (comma-separated origins: website + future CMS frontend)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# AWS S3 (for CMS image uploads via presigned URLs)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
S3_UPLOAD_PREFIX=uploads

# Google OAuth (CMS sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Comma-separated allowlist of emails permitted to access the CMS
ALLOWED_EMAILS=admin@example.com

# JWT session tokens issued by this backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Google Analytics 4 (powers the Studio dashboard)
# Numeric property id from GA Admin > Property Settings (not the G-XXXX tag id)
GA4_PROPERTY_ID=123456789
# Service-account key JSON, raw or base64-encoded. The account needs the Viewer
# role on the GA4 property (Admin > Property Access Management).
GA4_CREDENTIALS_JSON=
